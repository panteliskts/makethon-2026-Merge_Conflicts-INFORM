# Copy this file to backend/.env and fill real values locally.
# Never commit backend/.env.

# Required for Gemini OCR, embeddings, and chat.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

# Required for shared team persistence and Supabase Storage.
# Ask the team lead for these private values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Retrieval and generation defaults.
MAX_TOKENS=512
TOP_K=3
TOP_K_RETRIEVE=20
SCORE_THRESHOLD=0.35
RERANKER_ENABLED=false
MAX_HISTORY_TOKENS=800

# Local runtime.
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_TOKEN=
