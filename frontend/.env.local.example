NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ADMIN_API_TOKEN=

# Supabase public browser/server client values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth (optional — credentials login works without this)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override demo users (JSON array). Default: demo@inform.app / inform2026
# To generate a hash: node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"
# DEMO_USERS=[{"id":"1","name":"Alice","email":"alice@example.com","passwordHash":"$2a$10$..."}]
